# Solar ERP - Production environment template
#
# Copy this file to `.env.prod` on the production VPS and fill in real values.
# `.env.prod` is gitignored — the real file MUST NEVER be committed.
#
# Both docker-compose.prod.yml and the backend systemd service read variables
# from this file (see /etc/systemd/system/solar-erp-app.service).
#
# After editing, restart:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#   sudo systemctl restart solar-erp-app

# ---------------------------------------------------------------------------
# PostgreSQL (used by docker-compose.prod.yml AND backend)
# ---------------------------------------------------------------------------
POSTGRES_DB=solarerp
POSTGRES_USER=solarerp
POSTGRES_PASSWORD=REPLACE_FROM_BITWARDEN_SOLAR_ERP_DB_PASSWORD

# Backend uses these to connect — same DB, same user, same password.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=solarerp
DB_USERNAME=solarerp
DB_PASSWORD=REPLACE_FROM_BITWARDEN_SOLAR_ERP_DB_PASSWORD

# ---------------------------------------------------------------------------
# Spring profile
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ---------------------------------------------------------------------------
# JWT signing key (HS256) — 64 alphanumeric chars
# ---------------------------------------------------------------------------
JWT_SECRET=REPLACE_FROM_BITWARDEN_SOLAR_ERP_JWT_SECRET

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins
# For Android-only pilot, this can be empty/restrictive (apps don't enforce CORS).
# Set this to your web origins if/when you serve the Flutter web build.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=false

# ---------------------------------------------------------------------------
# Bootstrap admin (FIRST DEPLOYMENT ONLY)
#
# Set ENABLED=true for the very first startup. Log in, create real users,
# then set ENABLED=false and restart the backend.
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=bootstrap.admin
BOOTSTRAP_ADMIN_EMAIL=bootstrap.admin@solarerp.local
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_FROM_BITWARDEN_SOLAR_ERP_BOOTSTRAP_ADMIN
BOOTSTRAP_ADMIN_ROLE=ADMIN

# ---------------------------------------------------------------------------
# Optional tuning (sensible defaults already in application-prod.yaml)
# Uncomment and set if you need to override.
# ---------------------------------------------------------------------------
# DB_MIN_IDLE=5
# DB_MAX_POOL_SIZE=25
# DB_CONNECTION_TIMEOUT_MS=30000
# LOGIN_RATE_LIMIT_WINDOW_MINUTES=1
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=20
# LOGIN_LOCKOUT_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_DURATION_MINUTES=15
